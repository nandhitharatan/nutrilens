# Nutrilens Environment Variables (.env.example)

# Backend (FastAPI)
OCR_MIN_CONFIDENCE=0.80
ALLOWED_ORIGINS=http://localhost:3000

# Optional Cloud Integrations (Defaults to local Tesseract & heuristic fallback if unset)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GOOGLE_CREDENTIALS_JSON=your_google_cloud_vision_json
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
