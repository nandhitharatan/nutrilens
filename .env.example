# Nutrilens Environment Variables (.env.example)

# Backend (FastAPI)
OCR_MIN_CONFIDENCE=0.80
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini (Backend only)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# Optional Cloud Integrations (Defaults to local Tesseract & heuristic fallback if unset)
# GOOGLE_CREDENTIALS_JSON=your_google_cloud_vision_json
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
